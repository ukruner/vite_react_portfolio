{
    "hosting": {
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        { "source": "/api/**", "run": { "serviceId": "physiohelp-page-backend", "region": "europe-west1" } },
        { "source": "**", "destination": "/index.html" }
      ]
    }
  }
